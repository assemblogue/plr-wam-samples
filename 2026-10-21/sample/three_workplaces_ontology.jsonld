   "@id": "urn:tw:調達一覧",
   "@type": "ObjectProperty",
   "range": "urn:tw:調達",
   "subPropertyOf": "#refersTo",
   "label": "調達",
   "_comment": "誰も書かない refersTo の多値。予算合計の節が検索で値を作る（R554・R558・R560）"
  },
