{
 "_comment": "要素どうしの対応づけの例題（R463 の残りの1）。呼び出し側がリテラルの要素の並び、頭部がパターン1個（spec_branch.md の条件C）。要素の欄は呼び出し側の変数と同じ等価類に入る。クラス・属性の id は #名前（ASCII）。",
 "@id": "urn:pair:ontology",
 "@type": "Ontology",
 "agentProperty": "pairAgent",
 "defines": [
  {
   "@id": "#PairQuote",
   "@type": "Class",
   "subClassOf": [
    {
     "@type": "Restriction",
     "onProperty": "#total",
     "minCardinality": 0,
     "maxCardinality": 1
    }
   ],
   "label": {
    "ja": "見積"
   }
  },
  {
   "@id": "#PairOrder",
   "@type": "Class",
   "subClassOf": [
    {
     "@type": "Restriction",
     "onProperty": "#lines",
     "minCardinality": 0
    },
    {
     "@type": "Restriction",
     "onProperty": "#pairAgent",
     "minCardinality": 0,
     "maxCardinality": 1
    }
   ],
   "label": {
    "ja": "注文"
   }
  },
  {
   "@id": "#PairLine",
   "@type": "Class",
   "subClassOf": [
    {
     "@type": "Restriction",
     "onProperty": "#product",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#qty",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#amount",
     "minCardinality": 0,
     "maxCardinality": 1
    }
   ],
   "label": {
    "ja": "明細"
   }
  },
  {
   "@id": "#PairTimes",
   "@type": "Class",
   "builtInFunction": "×",
   "isConstraint": true,
   "label": {
    "ja": "×"
   }
  },
  {
   "@id": "#PairEquals",
   "@type": "Class",
   "builtInFunction": "=",
   "isConstraint": true,
   "label": {
    "ja": "＝"
   }
  },
  {
   "@id": "#lines",
   "@type": "ObjectProperty",
   "range": "#PairLine",
   "label": {
    "ja": "明細一覧"
   }
  },
  {
   "@id": "#product",
   "@type": "DatatypeProperty",
   "range": "string",
   "label": {
    "ja": "商品"
   }
  },
  {
   "@id": "#qty",
   "@type": "DatatypeProperty",
   "range": "integer",
   "label": {
    "ja": "個数"
   }
  },
  {
   "@id": "#amount",
   "@type": "DatatypeProperty",
   "range": "integer",
   "label": {
    "ja": "金額"
   }
  },
  {
   "@id": "#total",
   "@type": "DatatypeProperty",
   "range": "integer",
   "label": {
    "ja": "合計"
   }
  },
  {
   "@id": "#pairAgent",
   "@type": "ObjectProperty",
   "subPropertyOf": [
    "#agent"
   ],
   "label": {
    "ja": "担当者"
   }
  }
 ]
}