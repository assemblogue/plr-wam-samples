{
 "_comment": "いろいろな単一化を1つの流れに入れた例題（追記R385〜R387）。下位クラスのノードがパターンに当たる、属性階層での対応づけと置き換え、整数性や値域がクラスの属性での代替節の選択、数の多値は和。",
 "@id": "urn:uv:ontology",
 "@type": "Ontology",
 "defines": [
  {
   "@id": "urn:uv:Template",
   "@type": "Class",
   "subClassOf": [],
   "label": {
    "ja": "テンプレート"
   }
  },
  {
   "@id": "urn:uv:Atom",
   "@type": "Class",
   "subClassOf": [
    "urn:uv:Template"
   ],
   "label": {
    "ja": "アトムノード"
   }
  },
  {
   "@id": "urn:uv:Task",
   "@type": "Class",
   "subClassOf": [
    "urn:uv:Atom"
   ],
   "label": {
    "ja": "タスクノード"
   }
  },
  {
   "@id": "urn:uv:Constraint",
   "@type": "Class",
   "subClassOf": [
    "urn:uv:Atom"
   ],
   "label": {
    "ja": "制約ノード"
   }
  },
  {
   "@id": "urn:uv:OtherAtom",
   "@type": "Class",
   "subClassOf": [
    "urn:uv:Atom"
   ],
   "label": {
    "ja": "その他のアトムノード"
   }
  },
  {
   "@id": "urn:uv:Goal",
   "@type": "Class",
   "subClassOf": [
    "urn:uv:Task"
   ],
   "label": {
    "ja": "ゴール"
   }
  },
  {
   "@id": "urn:uv:Equals",
   "@type": "Class",
   "subClassOf": [
    "urn:uv:Constraint"
   ],
   "builtInFunction": "=",
   "isConstraint": true,
   "label": {
    "ja": "＝"
   }
  },
  {
   "@id": "urn:uv:Times",
   "@type": "Class",
   "subClassOf": [
    "urn:uv:Constraint"
   ],
   "builtInFunction": "×",
   "isConstraint": true,
   "label": {
    "ja": "×"
   }
  },
  {
   "@id": "urn:uv:Divide",
   "@type": "Class",
   "subClassOf": [
    "urn:uv:Constraint"
   ],
   "builtInFunction": "÷",
   "isConstraint": true,
   "label": {
    "ja": "÷"
   }
  },
  {
   "_comment": "品目。下位クラスのノード（文具・食品）が、品目のパターンに当たる。",
   "@id": "urn:uv:品目",
   "@type": "Class",
   "subClassOf": [
    {
     "@type": "Restriction",
     "onProperty": "urn:uv:名前",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:uv:入数",
     "minCardinality": 1,
     "maxCardinality": 1
    }
   ],
   "label": {
    "ja": "品目"
   }
  },
  {
   "@id": "urn:uv:文具",
   "@type": "Class",
   "subClassOf": [
    "urn:uv:品目"
   ],
   "label": {
    "ja": "文具"
   }
  },
  {
   "@id": "urn:uv:食品",
   "@type": "Class",
   "subClassOf": [
    "urn:uv:品目"
   ],
   "label": {
    "ja": "食品"
   }
  },
  {
   "@id": "urn:uv:担当者",
   "@type": "Class",
   "subClassOf": [
    {
     "@type": "Restriction",
     "onProperty": "urn:uv:名前",
     "minCardinality": 1,
     "maxCardinality": 1
    }
   ],
   "label": {
    "ja": "担当者"
   }
  },
  {
   "_comment": "社内の担当者。",
   "@id": "urn:uv:社員",
   "@type": "Class",
   "subClassOf": [
    "urn:uv:担当者"
   ],
   "label": {
    "ja": "社員"
   }
  },
  {
   "_comment": "外注先。",
   "@id": "urn:uv:取引先",
   "@type": "Class",
   "subClassOf": [
    "urn:uv:担当者"
   ],
   "label": {
    "ja": "取引先"
   }
  },
  {
   "_comment": "発注書。明細の金額を集めて総額を出す。総額は1つの数で、`＝` で明細の金額のリストと単一化する（値はその和）。",
   "@id": "urn:uv:発注書",
   "@type": "Class",
   "subClassOf": [
    "urn:uv:Goal",
    {
     "@type": "Restriction",
     "onProperty": "urn:uv:明細一覧",
     "minCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:uv:総額",
     "minCardinality": 0,
     "maxCardinality": 1
    }
   ],
   "label": {
    "ja": "発注書"
   }
  },
  {
   "_comment": "明細。データは単価を `価格` で持ち、明細の節は `値` と書く——共通の下位属性 `税込単価` に対応づけられ、書き出しで `税込単価` に置き換わる。",
   "@id": "urn:uv:明細",
   "@type": "Class",
   "subClassOf": [
    "urn:uv:Constraint",
    {
     "@type": "Restriction",
     "onProperty": "urn:uv:品目",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:uv:担当",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:uv:数量",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:uv:値",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:uv:金額",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:uv:区分",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:uv:箱数",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:uv:手配",
     "minCardinality": 0,
     "maxCardinality": 1
    }
   ],
   "label": {
    "ja": "明細"
   }
  },
  {
   "_comment": "梱包。箱数は非負整数なので、数量 ÷ 入数 が割り切れなければ「箱単位」の節は失敗し、「ばら」の節へ進む。",
   "@id": "urn:uv:梱包",
   "@type": "Class",
   "subClassOf": [
    "urn:uv:OtherAtom",
    {
     "@type": "Restriction",
     "onProperty": "urn:uv:数量",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:uv:入数",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:uv:区分",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:uv:箱数",
     "minCardinality": 1,
     "maxCardinality": 1
    }
   ],
   "label": {
    "ja": "梱包"
   }
  },
  {
   "_comment": "手配先。呼び出しは `担当` と書き、節の頭部は `社内担当`（値域 社員）か `外注先`（値域 取引先）と書く——どちらも `担当` の下位属性なので対応づけられ、値域に合う方の節が通る。",
   "@id": "urn:uv:手配先",
   "@type": "Class",
   "subClassOf": [
    "urn:uv:OtherAtom",
    {
     "@type": "Restriction",
     "onProperty": "urn:uv:社内担当",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:uv:外注先",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:uv:手配",
     "minCardinality": 1,
     "maxCardinality": 1
    }
   ],
   "label": {
    "ja": "手配先"
   }
  },
  {
   "@id": "urn:uv:名前",
   "@type": "DatatypeProperty",
   "range": "string",
   "label": {
    "ja": "名前"
   }
  },
  {
   "@id": "urn:uv:入数",
   "@type": "DatatypeProperty",
   "range": "positiveInteger",
   "label": {
    "ja": "入数"
   }
  },
  {
   "@id": "urn:uv:明細一覧",
   "@type": "ObjectProperty",
   "range": "urn:uv:明細",
   "label": {
    "ja": "明細一覧"
   }
  },
  {
   "@id": "urn:uv:総額",
   "@type": "DatatypeProperty",
   "range": "decimal",
   "label": {
    "ja": "総額"
   }
  },
  {
   "@id": "urn:uv:品目",
   "@type": "ObjectProperty",
   "range": "urn:uv:品目",
   "label": {
    "ja": "品目"
   }
  },
  {
   "@id": "urn:uv:担当",
   "@type": "ObjectProperty",
   "range": "urn:uv:担当者",
   "label": {
    "ja": "担当"
   }
  },
  {
   "_comment": "担当の下位属性。値域は社員。",
   "@id": "urn:uv:社内担当",
   "@type": "ObjectProperty",
   "subPropertyOf": "urn:uv:担当",
   "range": "urn:uv:社員",
   "label": {
    "ja": "社内担当"
   }
  },
  {
   "_comment": "担当の下位属性。値域は取引先。",
   "@id": "urn:uv:外注先",
   "@type": "ObjectProperty",
   "subPropertyOf": "urn:uv:担当",
   "range": "urn:uv:取引先",
   "label": {
    "ja": "外注先"
   }
  },
  {
   "@id": "urn:uv:数量",
   "@type": "DatatypeProperty",
   "range": "nonNegativeInteger",
   "label": {
    "ja": "数量"
   }
  },
  {
   "_comment": "単価を表す上位属性。",
   "@id": "urn:uv:値",
   "@type": "DatatypeProperty",
   "range": "decimal",
   "label": {
    "ja": "値"
   }
  },
  {
   "_comment": "単価を表すもう1つの属性（値とは兄弟）。",
   "@id": "urn:uv:価格",
   "@type": "DatatypeProperty",
   "range": "decimal",
   "label": {
    "ja": "価格"
   }
  },
  {
   "_comment": "値と価格の共通の下位属性。",
   "@id": "urn:uv:税込単価",
   "@type": "DatatypeProperty",
   "subPropertyOf": [
    "urn:uv:値",
    "urn:uv:価格"
   ],
   "range": "decimal",
   "label": {
    "ja": "税込単価"
   }
  },
  {
   "@id": "urn:uv:金額",
   "@type": "DatatypeProperty",
   "range": "decimal",
   "label": {
    "ja": "金額"
   }
  },
  {
   "@id": "urn:uv:区分",
   "@type": "DatatypeProperty",
   "range": "string",
   "label": {
    "ja": "区分"
   }
  },
  {
   "@id": "urn:uv:箱数",
   "@type": "DatatypeProperty",
   "range": "nonNegativeInteger",
   "label": {
    "ja": "箱数"
   }
  },
  {
   "@id": "urn:uv:手配",
   "@type": "DatatypeProperty",
   "range": "string",
   "label": {
    "ja": "手配"
   }
  }
 ]
}
