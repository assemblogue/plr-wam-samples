     "@id": "#U",
     "variableName": "U"
    },
    {
     "@id": "#C",
     "variableName": "C"
    },
    {
     "@id": "#Amount",
     "variableName": "Amount"
    },
    {
     "@id": "#Limit",
     "variableName": "Limit"
    }
   ],
   "internalGraph": [
    {
     "@id": "urn:node:注文",
     "@type": "urn:kobuy:注文",
     "urn:kobuy:金額": {
      "@id": "#Amount"
     },
     "urn:kobuy:agent": {
      "@id": "#U"
     }
    },
    {
     "_comment": "利用者ごとの限度額を引く（頭部だけ・本体が空のホーン節＝事実）。",
     "@id": "urn:node:限度額を引く",
     "@type": "urn:kobuy:利用者限度額",
     "urn:kobuy:利用者": {
      "@id": "#U"
     },
     "urn:kobuy:限度額": {
      "@id": "#Limit"
     }
    },
    {
     "_comment": "限度額 ≧ 金額。制約ノードなので、どの節の本体にあっても連立で同じように効く。",
     "@id": "urn:node:限度額チェック",
     "@type": "urn:kobuy:Geq",
     "arg1": {
      "@id": "#Limit"
     },
     "arg2": {
      "@id": "#Amount"
     }
    },
    {
     "@id": "urn:node:承認経路呼出",
     "@type": "urn:kobuy:承認経路",
     "urn:kobuy:会社": {
      "@id": "#C"
     },
     "urn:kobuy:金額": {
      "@id": "#Amount"
     }
    },
    {
     "@id": "urn:node:発注",
     "@type": "urn:kobuy:発注",
     "urn:kobuy:金額": {
      "@id": "#Amount"
     },
     "urn:kobuy:agent": "urn:entity:サプライヤ"
    },
    {
     "@id": "urn:node:購買.head#link1",
     "@type": "urn:kobuy:Then",
     "arg1": {
      "@id": "urn:node:注文"
     },
     "arg2": {
      "@id": "urn:node:承認経路呼出"
     }
    },
    {
     "@id": "urn:node:購買.head#link2",
     "@type": "urn:kobuy:Then",
     "arg1": {
      "@id": "urn:node:承認経路呼出"
     },
     "arg2": {
      "@id": "urn:node:発注"
     }
    }
   ]
  }
 ],
