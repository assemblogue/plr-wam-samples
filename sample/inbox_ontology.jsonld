{
 "_comment": "例題⑤ 担当者の受信箱。調達3案件と検収2案件が同時に走り、4人が自分のぶんを片付ける。1人が複数案件・複数業務種別をまたぐ。山田の限度額は案件をまたいで効く（多値の合計に掛かる制約）。",
 "@id": "urn:inbox:ontology",
 "@type": "Ontology",
 "agentProperty": "urn:inbox:agent",
 "defines": [
  {
   "@id": "urn:inbox:Template",
   "@type": "Class",
   "subClassOf": [
    {
     "@type": "Restriction",
     "onProperty": "wam:isComplete",
     "minCardinality": 0,
     "maxCardinality": 1
    }
   ],
   "label": {
    "ja": "テンプレート",
    "en": "Template"
   }
  },
  {
   "@id": "urn:inbox:Atom",
   "@type": "Class",
   "subClassOf": [
    "urn:inbox:Template"
   ],
   "label": {
    "ja": "アトムノード",
    "en": "Atom"
   }
  },
  {
   "@id": "urn:inbox:Task",
   "@type": "Class",
   "subClassOf": [
    "urn:inbox:Atom"
   ],
   "label": {
    "ja": "タスクノード",
    "en": "Task"
   }
  },
  {
   "@id": "urn:inbox:Constraint",
   "@type": "Class",
   "subClassOf": [
    "urn:inbox:Atom"
   ],
   "label": {
    "ja": "制約ノード",
    "en": "Constraint"
   }
  },
  {
   "@id": "urn:inbox:OtherAtom",
   "@type": "Class",
   "subClassOf": [
    "urn:inbox:Atom"
   ],
   "label": {
    "ja": "その他のアトムノード",
    "en": "Other atom"
   }
  },
  {
   "@id": "wam:isComplete",
   "@type": "DatatypeProperty",
   "domain": "urn:inbox:Template",
   "range": "string",
   "label": {
    "ja": "完成",
    "en": "Is complete"
   }
  },
  {
   "@id": "urn:inbox:Cancelable",
   "@type": "Class",
   "subClassOf": [
    "urn:inbox:Task"
   ],
   "label": {
    "ja": "取消可能",
    "en": "Cancelable"
   }
  },
  {
   "@id": "urn:inbox:Person",
   "@type": "Class",
   "subClassOf": [],
   "label": {
    "ja": "人",
    "en": "Person"
   }
  },
  {
   "@id": "urn:inbox:agent",
   "@type": "ObjectProperty",
   "range": "urn:inbox:Person",
   "label": {
    "ja": "担当者",
    "en": "Agent"
   }
  },
  {
   "@id": "urn:inbox:Geq",
   "@type": "Class",
   "subClassOf": [
    "urn:inbox:Constraint"
   ],
   "label": {
    "ja": "≧",
    "en": "AtLeast"
   },
   "builtInFunction": "≧",
   "isConstraint": true
  },
  {
   "@id": "urn:inbox:Then",
   "@type": "Class",
   "linkKind": "then",
   "label": {
    "ja": "Then",
    "en": "Then"
   }
  },
  {
