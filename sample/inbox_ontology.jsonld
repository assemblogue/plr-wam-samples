   "@type": "DatatypeProperty",
   "domain": "urn:inbox:Template",
   "range": "string",
   "label": {
    "ja": "完成",
    "en": "Is complete"
   }
  },
  {
   "@id": "urn:inbox:Cancelable",
   "@type": "Class",
   "subClassOf": [
    "urn:inbox:Task"
   ],
   "label": {
    "ja": "取消可能タスク",
    "en": "Cancelable"
   }
  },
  {
