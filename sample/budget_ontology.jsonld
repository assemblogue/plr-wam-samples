    },
    {
     "@type": "Restriction",
     "onProperty": "urn:bud:agent",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "wam:completeByOkButton",
     "minCardinality": 0,
     "maxCardinality": 1
    }
   ],
   "label": {
    "ja": "起案",
    "en": "Draft"
   }
  }
 ],
 "agentProperty": "urn:bud:agent"
}
