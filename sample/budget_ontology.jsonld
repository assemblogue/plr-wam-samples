     "onProperty": "#agent",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#completeOrSuspendByOkButton",
     "minCardinality": 0,
     "maxCardinality": 1
    }
   ],
   "label": {
    "ja": "起案",
    "en": "Draft"
   }
  },
  {
   "@id": "urn:bud:承認",
   "@type": "Class",
   "subClassOf": [
    "urn:bud:Cancelable",
    {
     "@type": "Restriction",
     "onProperty": "urn:bud:案件",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:bud:金額",
     "minCardinality": 1,
