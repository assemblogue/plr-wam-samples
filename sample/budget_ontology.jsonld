     "onProperty": "urn:bud:承認一覧",
     "minCardinality": 0
    },
    {
     "@type": "Restriction",
     "onProperty": "#agent",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#completeByOkButton",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#inChannel",
     "minCardinality": 0,
     "maxCardinality": 1
    }
   ],
   "label": {
    "ja": "予算",
    "en": "Budget"
   }
  },
