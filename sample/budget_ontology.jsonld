    "en": "Refers to"
   }
  },
  {
   "@id": "urn:bud:起案",
   "@type": "Class",
   "subClassOf": [
    "urn:bud:Cancelable",
    {
     "@type": "Restriction",
     "onProperty": "urn:bud:案件",
