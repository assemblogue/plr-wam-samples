     "onProperty": "urn:bud:利用者",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:bud:限度額",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:bud:調達一覧",
     "minCardinality": 0
    }
   ],
   "label": {
    "ja": "予算",
    "en": "Budget"
   },
   "_comment": "利用者ごとの予算。多値属性 調達 の値がチャネルの要素（山田が実行した調達）である。"
  },
  {
   "@id": "urn:bud:予算チェック",
   "@type": "Class",
   "subClassOf": [
    "urn:bud:Task"
   ],
   "label": {
    "ja": "予算チェック",
    "en": "Budget check"
   }
  },
  {
   "@id": "urn:bud:agent",
   "@type": "ObjectProperty",
   "range": "urn:bud:Person",
   "label": {
    "ja": "担当者",
    "en": "Agent"
   }
  },
  {
   "@id": "urn:bud:起案",
   "@type": "Class",
   "subClassOf": [
    "urn:bud:Task",
    {
     "@type": "Restriction",
     "onProperty": "urn:bud:案件",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:bud:金額",
     "minCardinality": 1,
