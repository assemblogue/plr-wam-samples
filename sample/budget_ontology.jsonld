     "onProperty": "#agent",
     "minCardinality": 1,
     "maxCardinality": 1
    }
   ],
   "label": {
    "ja": "承認",
    "en": "Approve"
   },
   "_comment": "予算担当が承認する。承認の OK を、予算の上での確定とみなす（追記R562・R563）"
  },
  {
   "@id": "urn:bud:調達",
   "@type": "Class",
   "subClassOf": [
    "urn:bud:Task",
    {
     "@type": "Restriction",
     "onProperty": "urn:bud:案件",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:bud:金額",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
