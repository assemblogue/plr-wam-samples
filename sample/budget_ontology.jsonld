     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#agent",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#inChannel",
     "minCardinality": 0,
     "maxCardinality": 1
    }
   ],
   "label": {
    "ja": "調達",
    "en": "Procurement"
   },
   "_comment": "業務フローノードの型（ゴール述語）。案件ごとに起動され、起案者の分割チャネルに入る（基幹業務。追記R494・R546）"
  },
  {
   "@id": "urn:bud:予算合計",
   "@type": "Class",
   "subClassOf": [
    "urn:bud:Cancelable",
    {
     "@type": "Restriction",
     "onProperty": "urn:bud:予算",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:bud:確定合計",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
