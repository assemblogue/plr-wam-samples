{
 "_comment": "【検証用】予算の限度額は、同じ利用者の調達の合計に掛かる（追記R487・R494）。調達は業務フロー（設定.調達 のゴール節）で、案件ごとに起動され、調達のチャネルにレコードとして並ぶ。調達の節は、予算の 調達一覧（refersTo の下位）で既にある調達のレコードを検索し、その金額の合計に限度額を掛ける。起案中の調達自身のレコードも 調達一覧 に入っているので、その金額は検索の結果として1回だけ数える（自分の金額を別に足さない）。",
 "@id": "urn:bud:ontology",
 "@type": "Ontology",
 "defines": [
  {
   "@id": "urn:bud:Template",
   "@type": "Class",
   "subClassOf": [
    {
     "@type": "Restriction",
     "onProperty": "wam:isComplete",
     "minCardinality": 0,
     "maxCardinality": 1
    }
   ],
   "label": {
    "ja": "テンプレート",
    "en": "Template"
   }
  },
  {
   "@id": "urn:bud:Atom",
   "@type": "Class",
   "subClassOf": [
    "urn:bud:Template"
   ],
   "label": {
    "ja": "アトムノード",
    "en": "Atom"
   }
  },
  {
   "@id": "urn:bud:Task",
   "@type": "Class",
   "subClassOf": [
    "urn:bud:Atom"
   ],
   "label": {
    "ja": "タスクノード",
    "en": "Task"
   }
  },
  {
   "@id": "urn:bud:Constraint",
   "@type": "Class",
   "subClassOf": [
    "urn:bud:Atom"
   ],
   "label": {
    "ja": "制約ノード",
    "en": "Constraint"
   }
  },
  {
   "@id": "urn:bud:OtherAtom",
   "@type": "Class",
   "subClassOf": [
    "urn:bud:Atom"
   ],
   "label": {
    "ja": "その他のアトムノード",
    "en": "Other atom"
   }
  },
  {
   "@id": "wam:isComplete",
   "@type": "DatatypeProperty",
   "domain": "urn:bud:Template",
   "range": "string",
   "label": {
    "ja": "完成",
    "en": "Is complete"
   }
  },
  {
   "@id": "urn:bud:Person",
   "@type": "Class",
   "subClassOf": [],
   "label": {
    "ja": "人",
    "en": "Person"
   }
  },
  {
   "@id": "urn:bud:Geq",
   "@type": "Class",
   "subClassOf": [
    "urn:bud:Constraint"
   ],
   "label": {
    "ja": "≧",
    "en": "AtLeast"
   },
   "builtInFunction": "≧",
   "isConstraint": true
  },
  {
   "@id": "arg1",
   "@type": "ObjectProperty",
   "label": {
    "ja": "第1引数",
    "en": "Arg 1"
   }
  },
  {
   "@id": "arg2",
   "@type": "ObjectProperty",
   "label": {
    "ja": "第2引数",
    "en": "Arg 2"
   }
  },
  {
   "@id": "urn:bud:案件",
   "@type": "DatatypeProperty",
   "range": "string",
   "label": {
    "ja": "案件",
    "en": "Case"
   }
  },
  {
   "@id": "urn:bud:金額",
   "@type": "DatatypeProperty",
   "range": "nonNegativeInteger",
   "label": {
    "ja": "金額",
    "en": "Amount"
   }
  },
  {
   "@id": "urn:bud:限度額",
   "@type": "DatatypeProperty",
   "range": "nonNegativeInteger",
   "label": {
    "ja": "限度額",
    "en": "Limit"
   }
  },
  {
   "@id": "urn:bud:利用者",
   "@type": "ObjectProperty",
   "range": "urn:bud:Person",
   "label": {
    "ja": "利用者",
    "en": "User"
   }
  },
  {
   "@id": "urn:bud:調達",
   "@type": "Class",
   "subClassOf": [
    {
     "@type": "Restriction",
     "onProperty": "urn:bud:案件",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:bud:金額",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:bud:agent",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    "urn:bud:Task"
   ],
   "label": {
    "ja": "調達",
    "en": "Procurement"
   },
   "_comment": "業務フロー（設定.調達 のゴール節の頭部）。案件ごとに起動され、そのレコードが調達のチャネルに入る。起案者が agent。金額は起案で入る（追記R487・R494）"
  },
  {
   "@id": "urn:bud:refersTo",
   "@type": "ObjectProperty",
   "_comment": "参照属性の上位属性",
   "label": {
    "ja": "参照",
    "en": "RefersTo"
   }
  },
  {
   "@id": "urn:bud:調達一覧",
   "@type": "ObjectProperty",
   "range": "urn:bud:調達",
   "label": {
    "ja": "調達",
    "en": "Procurements"
   },
   "subPropertyOf": "urn:bud:refersTo",
   "_comment": "既にある調達のレコードを指す（refersTo の下位）。予算の節は、ここに並ぶ調達を検索して金額を集める（追記R487）"
  },
  {
   "@id": "urn:bud:予算",
   "@type": "Class",
   "subClassOf": [
    "urn:bud:OtherAtom",
    {
     "@type": "Restriction",
     "onProperty": "urn:bud:利用者",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:bud:限度額",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:bud:調達一覧",
     "minCardinality": 0
    }
   ],
   "label": {
    "ja": "予算",
    "en": "Budget"
   },
   "_comment": "利用者ごとの予算。多値属性 調達 の値がチャネルの要素（山田が実行した調達）である。"
  },
  {
   "@id": "urn:bud:agent",
   "@type": "ObjectProperty",
   "range": "urn:bud:Person",
   "label": {
    "ja": "担当者",
    "en": "Agent"
   }
  },
  {
   "@id": "urn:bud:起案",
   "@type": "Class",
   "subClassOf": [
    "urn:bud:Task",
    {
     "@type": "Restriction",
     "onProperty": "urn:bud:案件",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:bud:金額",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:bud:agent",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "wam:completeOrSuspendByOkButton",
     "minCardinality": 0,
     "maxCardinality": 1
    }
   ],
   "label": {
    "ja": "起案",
    "en": "Draft"
   }
  },
  {
   "@id": "urn:bud:Channel",
   "@type": "Class",
   "label": {
    "ja": "チャネル",
    "en": "Channel"
   }
  },
  {
   "_comment": "ゴール節の頭部が持つチャネルの引数（追記263）。",
   "@id": "urn:bud:channel",
   "@type": "ObjectProperty",
   "range": "urn:bud:Channel",
   "label": {
    "ja": "チャネル",
    "en": "Channel"
   }
  }
 ],
 "agentProperty": "urn:bud:agent",
 "channelProperty": "urn:bud:channel"
}
