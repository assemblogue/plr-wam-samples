        {
          "@id": "#N1",
          "variableName": "N1"
        },
        {
          "@id": "#N2",
          "variableName": "N2"
        },
        {
          "@id": "#Q1",
          "variableName": "Q1"
        },
        {
          "@id": "#Q2",
          "variableName": "Q2"
        },
        {
          "@id": "#T",
          "variableName": "T"
