{
  "@id": "urn:pr:ontology",
  "@type": "Ontology",
  "_comment": "属性はすべて cardinality が 0 か 1。クラスid・属性idは絶対URI、range のデータ型名は接頭辞なし。",
  "defines": [
    {
      "@id": "urn:pr:単価・掛率",
      "@type": "Class",
      "subClassOf": [
        {
          "@type": "Restriction",
          "onProperty": "urn:pr:商品",
          "minCardinality": 0,
          "maxCardinality": 1
        },
        {
          "@type": "Restriction",
          "onProperty": "urn:pr:バイヤー",
          "minCardinality": 0,
          "maxCardinality": 1
        },
        {
          "@type": "Restriction",
          "onProperty": "urn:pr:単価",
          "minCardinality": 0,
          "maxCardinality": 1
        },
        {
          "@type": "Restriction",
          "onProperty": "urn:pr:掛率",
          "minCardinality": 0,
          "maxCardinality": 1
        }
      ],
      "label": {
        "ja": "単価・掛率",
        "en": "Unit price and rate"
      }
    },
    {
