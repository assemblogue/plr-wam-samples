  {
   "@id": "urn:kord:refersTo",
   "@type": "ObjectProperty",
   "_comment": "参照属性の上位属性。この下位の属性の欄は、既存の実体を指すか、ほかの欄に既にある値と単一化するだけで、新しい値は入れられない（追記R517）",
   "label": {
    "ja": "参照",
    "en": "RefersTo"
   }
  },
  {
   "@id": "urn:kord:納入数",
   "@type": "DatatypeProperty",
   "subPropertyOf": "urn:kord:refersTo",
   "range": "nonNegativeInteger",
   "_comment": "検収から見た出荷数。サプライヤの出荷の 出荷数 を、受け取る側のバイヤーが読む値なので refersTo の下位属性である——バイヤーは書けない（追記R516・R517）",
   "label": {
    "ja": "納入数",
    "en": "Delivered quantity"
   }
  },
  {
   "@id": "urn:kord:単価",
   "@type": "DatatypeProperty",
   "range": "nonNegativeInteger",
   "label": {
    "ja": "単価",
    "en": "Unit price"
   }
  },
  {
   "@id": "urn:kord:税込金額",
   "@type": "DatatypeProperty",
   "range": "nonNegativeInteger",
   "label": {
    "ja": "税込金額",
    "en": "Gross amount"
   }
  },
  {
   "@id": "urn:kord:納入予定日",
   "@type": "DatatypeProperty",
   "range": "string",
   "label": {
    "ja": "納入予定日",
    "en": "Promised delivery date"
   }
  },
  {
