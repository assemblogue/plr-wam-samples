   "subClassOf": [
    "urn:kord:Task"
   ],
   "label": {
    "ja": "補償可能タスク",
    "en": "Compensable"
   }
  },
  {
   "@id": "urn:kord:Incompensable",
   "@type": "Class",
   "subClassOf": [
    "urn:kord:Task"
   ],
   "label": {
    "ja": "補償不能タスク",
    "en": "Incompensable"
   }
  },
  {
   "@id": "urn:kord:Channel",
   "@type": "Class",
   "label": {
    "ja": "チャネル",
    "en": "Channel"
   }
  },
  {
   "_comment": "ゴール節の頭部が持つチャネルの引数（追記263）。エンジンにはこの属性idだけを注入する。",
   "@id": "urn:kord:channel",
