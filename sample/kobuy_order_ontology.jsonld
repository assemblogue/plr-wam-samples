    "en": "Shipping date"
   }
  },
  {
   "@id": "urn:kord:企業",
   "@type": "ObjectProperty",
   "range": "urn:kord:Company",
   "label": {
    "ja": "企業",
    "en": "Company"
   }
  },
  {
   "@id": "urn:kord:注文",
   "@type": "Class",
   "subClassOf": [
    "urn:kord:Cancelable",
    {
     "@type": "Restriction",
     "onProperty": "urn:kord:注文数",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:kord:単価",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:kord:agent",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "wam:completeOrSuspendByOkButton",
     "minCardinality": 0,
     "maxCardinality": 1
    }
   ],
   "label": {
    "ja": "注文",
    "en": "Order"
   },
   "_comment": "バイヤーが注文する。サプライヤ側から見た受注の元である（マニュアル §3.2.1.1「バイヤーからの注文通知」）。"
  },
  {
   "@id": "urn:kord:受注受付",
   "@type": "Class",
   "subClassOf": [
    "urn:kord:Cancelable",
    {
     "@type": "Restriction",
     "onProperty": "urn:kord:注文数",
     "minCardinality": 1,
