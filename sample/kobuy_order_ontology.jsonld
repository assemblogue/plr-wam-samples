     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "wam:completeOrSuspendByOkButton",
     "minCardinality": 0,
     "maxCardinality": 1
    }
   ],
   "label": {
    "ja": "納期回答",
    "en": "Delivery date reply"
   },
   "_comment": "サプライヤが単価・数量・納入予定日を設定する（§3.2.1.3）。"
  },
  {
   "@id": "urn:kord:出荷",
