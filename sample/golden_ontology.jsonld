      "label": {
        "ja": "人",
        "en": "Person"
      }
    },
    {
      "@id": "urn:golden:agent",
      "@type": "ObjectProperty",
      "range": "urn:golden:Person",
      "label": {
        "ja": "担当者",
        "en": "Agent"
      }
    },
    {
      "@id": "urn:golden:組織",
      "@type": "Class",
