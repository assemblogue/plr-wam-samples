{
 "_comment": "KOBUY の請求締め処理（マニュアル §6.6.1）を、組込述語 帳票集約 ひとつで書く例題。spec_builtin.md「組込タスク述語 帳票集約」の例がそのままこの業務である——売上伝票明細を 締日・請求先・差出人・部門・任意コード ごとにまとめ、まとまりごとに請求書を1通作る。",
 "@id": "urn:kbil:ontology",
 "@type": "Ontology",
 "agentProperty": "urn:kbil:agent",
 "defines": [
  {"@id": "urn:kbil:Template", "@type": "Class",
   "subClassOf": [{"@type": "Restriction", "onProperty": "wam:isComplete", "minCardinality": 0, "maxCardinality": 1}],
   "label": {"ja": "テンプレート", "en": "Template"}},
  {"@id": "urn:kbil:Atom", "@type": "Class", "subClassOf": ["urn:kbil:Template"], "label": {"ja": "アトムノード", "en": "Atom"}},
  {"@id": "urn:kbil:Task", "@type": "Class", "subClassOf": ["urn:kbil:Atom"], "label": {"ja": "タスクノード", "en": "Task"}},
  {"@id": "urn:kbil:Goal", "@type": "Class", "subClassOf": ["urn:kbil:Task"], "label": {"ja": "ゴール", "en": "Goal"}},
  {"@id": "urn:kbil:Constraint", "@type": "Class", "subClassOf": ["urn:kbil:Atom"], "label": {"ja": "制約ノード", "en": "Constraint"}},
  {"@id": "urn:kbil:OtherAtom", "@type": "Class", "subClassOf": ["urn:kbil:Atom"], "label": {"ja": "その他のアトムノード", "en": "Other atom"}},
  {"@id": "wam:isComplete", "@type": "DatatypeProperty", "domain": "urn:kbil:Template", "range": "string", "label": {"ja": "完成", "en": "Is complete"}},

  {"@id": "urn:kbil:Person", "@type": "Class", "label": {"ja": "人", "en": "Person"}},
  {"@id": "urn:kbil:agent", "@type": "ObjectProperty", "range": "urn:kbil:Person", "label": {"ja": "担当者", "en": "Agent"}},
  {"@id": "urn:kbil:Then", "@type": "Class", "linkKind": "then", "label": {"ja": "Then", "en": "Then"}},
  {"@id": "arg1", "@type": "ObjectProperty", "label": {"ja": "第1引数", "en": "Arg 1"}},
  {"@id": "arg2", "@type": "ObjectProperty", "label": {"ja": "第2引数", "en": "Arg 2"}},

  {"@id": "urn:kbil:締日", "@type": "DatatypeProperty", "range": "string", "label": {"ja": "締日", "en": "Closing date"}},
  {"@id": "共通", "@type": "ObjectProperty", "label": {"ja": "共通", "en": "Common"}},
  {"@id": "個別", "@type": "ObjectProperty", "label": {"ja": "個別", "en": "Individual"}},
  {"@id": "統合", "@type": "ObjectProperty", "label": {"ja": "統合", "en": "Integrated"}},

  {
   "_comment": "組込タスク述語。引数は 共通・個別・統合 の3つで、いずれもパターンのノードURIを指す（cardinality は1）。パターンは _aggregationPatterns に置く。",
   "@id": "urn:kbil:帳票集約", "@type": "Class",
   "builtInFunction": "帳票集約",
   "subClassOf": ["urn:kbil:Task",
    {"@type": "Restriction", "onProperty": "共通", "minCardinality": 1, "maxCardinality": 1},
    {"@type": "Restriction", "onProperty": "個別", "minCardinality": 1, "maxCardinality": 1},
    {"@type": "Restriction", "onProperty": "統合", "minCardinality": 1, "maxCardinality": 1}],
   "label": {"ja": "帳票集約", "en": "Form aggregation"}
  },
  {
   "_comment": "管理会社が締め日を入れて実行する（マニュアル §6.6.1 の「請求締め処理」画面）。",
   "@id": "urn:kbil:締め処理", "@type": "Class",
   "subClassOf": ["urn:kbil:Task",
    {"@type": "Restriction", "onProperty": "urn:kbil:締日", "minCardinality": 1, "maxCardinality": 1},
    {"@type": "Restriction", "onProperty": "urn:kbil:agent", "minCardinality": 1, "maxCardinality": 1},
    {"@type": "Restriction", "onProperty": "wam:completeByOkButton", "minCardinality": 0, "maxCardinality": 1}],
   "label": {"ja": "締め処理", "en": "Close billing"}
  },
  {"@id": "urn:kbil:請求締め", "@type": "Class",
   "subClassOf": ["urn:kbil:OtherAtom",
    {"@type": "Restriction", "onProperty": "urn:kbil:締日", "minCardinality": 1, "maxCardinality": 1}],
   "label": {"ja": "請求締め", "en": "Billing close"}},
  {"@id": "urn:kbil:請求締めゴール", "@type": "Class", "subClassOf": ["urn:kbil:Goal"], "label": {"ja": "請求締めゴール", "en": "Billing close goal"}}
 ]
}
