    }
   ],
   "label": "承認経路"
  },
  {
   "@id": "#成員",
   "@type": "Class",
   "builtInFunction": "成員",
   "isConstraint": true,
   "_comment": "組込述語 成員(主体: G, 人: A)。A が G そのものか、G の就任者・メンバー（入れ子も辿る）",
   "subClassOf": [
    {
     "@type": "Restriction",
     "onProperty": "#主体",
     "minCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#人",
     "minCardinality": 1
    }
   ],
   "label": "成員"
  },
  {
   "@id": "#真",
   "@type": "Class",
   "builtInFunction": "真",
   "isConstraint": true,
   "_comment": "システムの組込の制約述語（追記R486）。引数を持たず、真偽値は常に T",
   "label": "真"
  },
  {
   "@id": "#Geq",
   "@type": "Class",
   "builtInFunction": "≧",
   "isConstraint": true,
   "_comment": "システムの組込（Equals・Times と同じ）。≧(arg1, arg2) は arg1 ≧ arg2",
   "label": "≧"
  },
  {
   "@id": "#⊆",
   "@type": "Class",
   "builtInFunction": "⊆",
   "isConstraint": true,
   "_comment": "システムの組込の制約述語（追記K358）。⊆(arg1, arg2) は arg1 の要素がすべて arg2 にある",
   "label": "⊆"
  },
  {
   "@id": "#Times",
   "@type": "Class",
   "builtInFunction": "×",
   "isConstraint": true,
   "_comment": "足した（見積書の例題と同じ形）",
   "label": "×"
  },
  {
   "@id": "#Equals",
   "@type": "Class",
   "builtInFunction": "=",
   "isConstraint": true,
   "_comment": "足した（見積書の例題と同じ形）",
   "label": "＝"
  },
