{
 "_comment": "doc/wam/examples/kobuy_workplace.jsonld（ONTO2 のワークプレース）を tool/convert_workplace.py でハーネスの形式にしたもの。KOBUY の購買とトークのワークプレース（ONTO2 インスタンス）の例。説明は doc/wam/workplace_example.md。語彙は Ontology.xlsx の Ontology (6) と Rendering.xlsx の Rend (4)。ホーン節は spec_kg.md「ホーン節の JSON 表現」（追記207）の形。_ で始まる鍵は説明のための注記で、データではない。 値域から導ける @type（ONTO1・ONTO3・ONTO4・ONTOc）は書かない。",
 "@id": "urn:kobuy:ontology",
 "@type": "Ontology",
 "agentProperty": "agent",
 "channelProperty": "inChannel",
 "_taskAccess": "業務フロー定義が担当者を制約しないタスクは、チャネルの TaskAccess が担当者を決める（spec_ops.md）。エンジンへ渡す述語と属性。class はエンジンが節に入れる標準の節の述語、recordClass はチャネルの要素",
 "taskAccess": {
  "class": "TaskAgent",
  "channel": "channel",
  "task": "task",
  "agent": "person",
  "recordClass": "TaskAccess",
  "recordAgent": "taskAgent",
  "memberProperties": [
   "就任者",
   "メンバー"
  ]
 },
 "defines": [
  {
   "@id": "urn:kobuy:購買",
   "@type": "Class",
   "subClassOf": [
    "#Cancelable",
    {
     "@type": "Restriction",
     "onProperty": "urn:kobuy:件名",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#agent",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#inChannel",
     "minCardinality": 0,
     "maxCardinality": 1
    }
   ],
   "label": "購買"
  },
  {
