{
 "_comment": "doc/wam/examples/kobuy_workplace.jsonld（ONTO2 のワークプレース）を tool/convert_workplace.py でハーネスの形式にしたもの。KOBUY の購買とトークのワークプレース（ONTO2 インスタンス）の例。説明は doc/wam/workplace_example.md。語彙は Ontology.xlsx の Ontology (6) と Rendering.xlsx の Rend (4)。ホーン節は spec_kg.md「ホーン節の JSON 表現」（追記207）の形。_ で始まる鍵は説明のための注記で、データではない。 値域から導ける @type（ONTO1・ONTO3・ONTO4・ONTOc）は書かない。",
 "@id": "urn:kobuy:ontology",
 "@type": "Ontology",
 "ontoG": [
  "urn:kobuy:購買",
  "urn:kobuy:相談",
  "urn:kobuy:商品C",
  "urn:kobuy:取引先C"
 ],
 "agentProperty": "agent",
 "channelProperty": "inChannel",
 "_taskAccess": "業務フロー定義が担当者を制約しないタスクは、チャネルの TaskAccess+ が担当者を決める（spec_ops.md）。エンジンへ渡す述語と属性。class はエンジンが節に入れる標準の節の述語、recordClass はチャネルの要素",
 "taskAccess": {
  "class": "TaskAgent",
  "channel": "channel",
  "task": "task",
  "agent": "taskAgent",
  "recordClass": "TaskAccess+",
  "recordAgent": "taskAgent+",
  "includesTask": "includesTask",
  "memberProperties": [
   "就任者",
   "メンバー"
  ]
 },
 "channelSettings": {
  "urn:kobuy:設定.購買": {
   "includesTask": [
    "urn:kobuy:購買",
    "urn:kobuy:相談"
   ]
  },
  "urn:kobuy:設定.商品マスター": {
   "includesTask": [
    "urn:kobuy:商品C",
    "urn:kobuy:取引先C"
   ]
  }
 },
 "channels": {
  "urn:channel:購買.田中": "urn:kobuy:設定.購買",
  "urn:channel:備品の相談": "urn:kobuy:設定.購買",
  "urn:channel:商品マスター": "urn:kobuy:設定.商品マスター",
  "urn:channel:組織マスター": "urn:system:設定.組織マスター"
 },
 "defines": [
  {
   "@id": "#Task",
   "@type": "Class",
   "subClassOf": [],
   "_comment": "システムワークプレースの Task。onto10 に下位クラスを書く（Cancelable・Incompensable もシステムのクラスで、その onto10 に組織のクラスを書く）。この文は組織のワークプレースの中にあり、システムワークプレースを書き換えない。クラスであることは onto10 の値域から、タスクでないクラス（明細）は属性の値域（onto32）から導かれるので、onto6 には Task だけを挙げる"
  },
  {
   "@id": "#Cancelable",
   "@type": "Class",
   "subClassOf": [
    "#Task"
   ]
  },
  {
   "@id": "urn:kobuy:購買",
   "@type": "Class",
   "subClassOf": [
    "#Cancelable",
    {
     "@type": "Restriction",
     "onProperty": "urn:kobuy:件名",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#agentWithOK",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#inChannel",
     "minCardinality": 0,
     "maxCardinality": 1
    }
   ],
   "label": "購買"
  },
  {
   "@id": "urn:kobuy:承認C",
   "@type": "Class",
   "subClassOf": [
    "#Cancelable",
    {
     "@type": "Restriction",
     "onProperty": "urn:kobuy:判断",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:kobuy:コメント",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#agentWithOK",
     "minCardinality": 0,
     "maxCardinality": 1
    }
   ],
   "label": "承認"
  },
  {
   "@id": "#Incompensable",
   "@type": "Class",
   "subClassOf": [
    "#Task"
   ]
  },
  {
   "@id": "urn:kobuy:発注C",
   "@type": "Class",
   "subClassOf": [
    "#Incompensable",
    {
     "@type": "Restriction",
     "onProperty": "urn:kobuy:発注日",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:kobuy:発注先",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#agentWithOK",
     "minCardinality": 0,
     "maxCardinality": 1
    }
   ],
   "label": "発注"
  },
  {
   "@id": "urn:kobuy:注文C",
   "@type": "Class",
   "subClassOf": [
    "#Task",
    {
     "@type": "Restriction",
     "onProperty": "urn:kobuy:明細一覧",
     "minCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:kobuy:金額",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:kobuy:希望納期",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#agentWithOK",
     "minCardinality": 0,
     "maxCardinality": 1
    }
   ],
   "label": "注文"
  },
  {
   "@id": "urn:kobuy:明細C",
   "@type": "Class",
   "subClassOf": [
    {
     "@type": "Restriction",
     "onProperty": "urn:kobuy:商品",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:kobuy:数量",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:kobuy:単価",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:kobuy:明細金額",
     "minCardinality": 1,
     "maxCardinality": 1
    }
   ],
   "label": "明細"
  },
  {
   "@id": "urn:kobuy:相談",
   "@type": "Class",
   "subClassOf": [
    "#Task",
    {
     "@type": "Restriction",
     "onProperty": "urn:kobuy:本文",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:kobuy:関連する購買",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#agentWithOK",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#inChannel",
     "minCardinality": 0,
     "maxCardinality": 1
    }
   ],
   "label": "相談"
  },
  {
   "@id": "urn:kobuy:商品C",
   "@type": "Class",
   "subClassOf": [
    "#Task",
    {
     "@type": "Restriction",
     "onProperty": "urn:kobuy:商品名",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:kobuy:商品単価",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:kobuy:仕入先",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#agentWithOK",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#inChannel",
     "minCardinality": 0,
     "maxCardinality": 1
    }
   ],
   "label": "商品"
  },
  {
   "@id": "urn:kobuy:取引先C",
   "@type": "Class",
   "subClassOf": [
    "#Task",
    {
     "@type": "Restriction",
     "onProperty": "urn:kobuy:取引先名",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#agentWithOK",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#inChannel",
     "minCardinality": 0,
     "maxCardinality": 1
    }
   ],
   "label": "取引先"
  },
  {
   "@id": "urn:kobuy:判断C",
   "@type": "Class",
   "subClassOf": [
    "#Task"
   ],
   "label": "判断",
   "_comment": "判断もタスク（承認の担当者がする）。承認の中に埋め込まれる。下位の 承認する・差し戻す のどちらかのインスタンスになる"
  },
  {
   "@id": "urn:kobuy:承認する",
   "@type": "Class",
   "subClassOf": [
    "urn:kobuy:判断C"
   ],
   "label": "承認する"
  },
  {
   "@id": "urn:kobuy:差し戻す",
   "@type": "Class",
   "subClassOf": [
    "urn:kobuy:判断C"
   ],
   "label": "差し戻す"
  },
  {
   "@id": "urn:kobuy:承認経路",
   "@type": "Class",
   "_comment": "承認経路（節 rule.承認経路.A社 の述語）。例の onto6 に宣言が無いので足した",
   "subClassOf": [
    {
     "@type": "Restriction",
     "onProperty": "#会社",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#金額",
     "minCardinality": 1,
     "maxCardinality": 1
    }
   ],
   "label": "承認経路"
  },
  {
   "@id": "#成員",
   "@type": "Class",
   "builtInFunction": "成員",
   "isConstraint": true,
   "_comment": "組込述語 成員(主体: G, 人: A)。A が G そのものか、G の就任者・メンバー（入れ子も辿る）",
   "subClassOf": [
    {
     "@type": "Restriction",
     "onProperty": "#主体",
     "minCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#人",
     "minCardinality": 1
    }
   ],
   "label": "成員"
  },
  {
   "@id": "#Then",
   "@type": "Class",
   "linkKind": "then",
   "label": "Then"
  },
  {
   "@id": "#Times",
   "@type": "Class",
   "builtInFunction": "×",
   "isConstraint": true,
   "_comment": "足した（見積書の例題と同じ形）",
   "label": "×"
  },
  {
   "@id": "#Equals",
   "@type": "Class",
   "builtInFunction": "=",
   "isConstraint": true,
   "_comment": "足した（見積書の例題と同じ形）",
   "label": "＝"
  },
  {
   "@id": "#TaskAgent",
   "@type": "Class",
   "_comment": "系が持つ標準の節の述語（spec_ops.md）。TaskAgent(channel: C, task: T, taskAgent: A) :- TaskAccess+(channel: C, task: T, taskAgent+: G), 成員(主体: G, 人: A).",
   "subClassOf": [
    {
     "@type": "Restriction",
     "onProperty": "#channel",
     "minCardinality": 0
    },
    {
     "@type": "Restriction",
     "onProperty": "#task",
     "minCardinality": 0
    },
    {
     "@type": "Restriction",
     "onProperty": "#taskAgent",
     "minCardinality": 0
    }
   ],
   "label": "TaskAgent"
  },
  {
   "@id": "#TaskAccess+",
   "@type": "Class",
   "_comment": "チャネルを作る人が決めた、タスクごとの書ける主体・読める主体。チャネルのノードの中に置く",
   "subClassOf": [
    {
     "@type": "Restriction",
     "onProperty": "#channel",
     "minCardinality": 0
    },
    {
     "@type": "Restriction",
     "onProperty": "#task",
     "minCardinality": 0
    },
    {
     "@type": "Restriction",
     "onProperty": "#taskAgent+",
     "minCardinality": 0
    },
    {
     "@type": "Restriction",
     "onProperty": "#taskUser+",
     "minCardinality": 0
    },
    {
     "@type": "Restriction",
     "onProperty": "#agentWithOK",
     "minCardinality": 0
    },
    {
     "@type": "Restriction",
     "onProperty": "wam:completeByOkButton",
     "minCardinality": 0
    }
   ],
   "label": "TaskAccess+"
  },
