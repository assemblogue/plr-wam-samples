{
  "_comment": "見積書デモの**共有データ版**。明細2本が**同じ納品先**（urn:entity:dest-1）を指している——`urn:quote:lineDestination` は `refersTo` の下位ではないので、納品先は**共有ノード**である。**明細も見積書もそこに達する**ので、完成はボトムアップに維持した値をそのまま使わず求め直される（追記246・250）。",
  "urn:quote:QuoteRecord": [
    {
      "_comment": "見積書のホーン節。**頭部がトップレベルのタスクノードである**——明細のパターンと総額をどちらも頭部が持つ。パターンを書くことが「各要素へ分配せよ」の宣言であり（追記205）、頭部に現れたアトムノードは本体のアトムノードでもある（追記215・216）ので、明細1本ずつがそれ自身のタスクノードとして解かれる。",
      "@id": "urn:node:Quote.head",
      "@type": "urn:quote:QuoteRecord",
      "variables": [
        {
          "@id": "#T",
          "variableName": "T",
          "@type": "nonNegativeInteger"
        },
        {
          "@id": "#Amount",
          "variableName": "Amount",
          "@type": "nonNegativeInteger"
        },
        {
          "@id": "#Qty",
          "variableName": "Qty",
          "@type": "nonNegativeInteger"
        },
        {
          "@id": "#Label",
          "variableName": "Label",
          "@type": "string"
        },
        {
          "@id": "#Unit",
          "variableName": "Unit",
          "@type": "nonNegativeInteger"
        },
        {
          "@id": "#Agent",
          "variableName": "Agent"
        },
        {
          "@id": "#Dest",
          "variableName": "Dest"
        }
      ],
      "urn:quote:lineItem": {
        "@type": "urn:quote:QuoteLine",
        "urn:quote:lineAmount": {
          "@id": "#Amount"
        },
        "urn:quote:lineQuantity": {
          "@id": "#Qty"
        },
        "urn:quote:lineProduct": {
          "@type": "urn:quote:CatalogItem",
          "urn:quote:itemLabel": {
            "@id": "#Label"
          },
          "urn:quote:itemPrice": {
            "@id": "#Unit"
          }
        },
        "urn:quote:lineDestination": {
          "@id": "#Dest"
        }
      },
      "urn:quote:agent": {
        "@id": "#Agent"
      },
      "urn:quote:total": {
        "@id": "#T"
      },
      "internalGraph": [
        {
          "_comment": "多値引数の値は和である。= は総額の側を束縛する（追記204）。",
          "@id": "urn:node:total",
          "@type": "urn:quote:Equals",
          "arg1": {
            "@id": "#T"
          },
          "arg2": {
            "@id": "#Amount"
          }
        }
      ]
    },
    {
      "_comment": "見積書1件。明細2本が同じ納品先を指している。",
      "@id": "urn:entity:quote-001",
      "urn:quote:lineItem": [
        "urn:entity:line-1",
        "urn:entity:line-2"
      ],
      "urn:quote:agent": "urn:entity:buyer"
    }
  ],
  "urn:quote:QuoteLine": [
    {
      "_comment": "明細のホーン節。⚠️ 単価は商品の属性であって明細の欄ではない——頭部に入れ子のパターンで書き、商品から取る。 ⚠️ **担当者は明細の欄ではない**——頭部に書かなければ明細は担当者を持たない（個数はホーン節が決める）。持たせると、見積書と明細が同じ担当者を指して**担当者が共有ノードになる**（追記250・252）。根である見積書が指せば足りる。",
      "@id": "urn:node:LineItem.head",
      "variables": [
        {
          "@id": "#Q",
          "variableName": "Q",
          "@type": "nonNegativeInteger"
        },
        {
          "@id": "#U",
          "variableName": "U",
          "@type": "nonNegativeInteger"
        },
        {
          "@id": "#A",
          "variableName": "A",
          "@type": "nonNegativeInteger"
        },
        {
          "@id": "#Dest2",
          "variableName": "Dest2"
        }
      ],
      "urn:quote:lineQuantity": {
        "@id": "#Q"
      },
      "urn:quote:lineAmount": {
        "@id": "#A"
      },
      "internalGraph": [
        {
          "_comment": "金額 = 単価 × 数量。要素ごとの計算はここにある。",
          "@id": "urn:node:lineAmount",
          "@type": "urn:quote:Times",
          "arg1": [
            {
              "@id": "#U"
            },
            {
              "@id": "#Q"
            }
          ],
          "arg2": {
            "@id": "#A"
          }
        }
      ],
      "urn:quote:lineProduct": {
        "@type": "urn:quote:CatalogItem",
        "urn:quote:itemPrice": {
          "@id": "#U"
        }
      },
      "urn:quote:lineDestination": {
        "@id": "#Dest2"
      }
    },
    {
      "_comment": "⚠️ 入力しかけの明細。商品は選んであるが数量がまだ無い。金額も当然まだ無い。",
      "@id": "urn:entity:line-1",
      "urn:quote:lineProduct": "urn:entity:pencil-2b",
      "urn:quote:lineDestination": "urn:entity:dest-1"
    },
    {
