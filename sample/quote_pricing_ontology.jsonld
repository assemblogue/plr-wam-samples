    },
    {
     "@type": "Restriction",
     "onProperty": "urn:qp:総額",
     "minCardinality": 0,
     "maxCardinality": 1
    }
   ],
   "label": {
    "ja": "見積書",
    "en": "Quote"
   }
  },
  {
   "_comment": "明細。商品（チャネルの商品マスターDB）とバイヤーから単価と掛率を求め、金額 = 単価 × 掛率 × 数量。",
   "@id": "urn:qp:明細",
   "@type": "Class",
   "subClassOf": [
    "urn:qp:Constraint",
    {
     "@type": "Restriction",
     "onProperty": "urn:qp:商品",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
