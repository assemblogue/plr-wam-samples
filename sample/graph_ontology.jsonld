      ],
      "label": {
        "ja": "アトムノード",
        "en": "Atom"
      }
    },
    {
      "_comment": "タスクノード（副作用を伴う。真偽値を持つ）。Goal の親である（追記261）。",
      "@id": "urn:gc:Task",
      "@type": "Class",
      "subClassOf": [
        "urn:gc:Atom"
      ],
      "label": {
        "ja": "タスクノード",
        "en": "Task"
      }
    },
    {
      "@id": "urn:gc:Quote",
      "@type": "Class",
      "subClassOf": [
        "urn:gc:Goal"
      ],
      "label": {
        "ja": "見積書",
        "en": "Quote"
      }
    },
    {
