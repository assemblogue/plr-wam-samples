      "label": {
        "ja": "テンプレート",
        "en": "Template"
      }
    },
    {
      "@id": "urn:gc:Goal",
      "@type": "Class",
      "subClassOf": [
        "urn:gc:Task"
      ],
      "label": {
        "ja": "ゴール",
        "en": "Goal"
      }
    },
    {
      "@id": "urn:gc:Atom",
      "@type": "Class",
