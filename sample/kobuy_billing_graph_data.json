{
  "_comment": "請求締め処理。売上伝票明細4件（tut.md「帳票集約: 請求書生成の具体例」と同じ）から請求書2通を作る。①②③は共通部分が一致し1通に、④は請求先が違うので別の1通になる。",

  "urn:kbil:請求締めゴール": [
    {
      "@id": "urn:node:請求締めゴール.head",
      "@type": "urn:kbil:請求締めゴール",
      "internalGraph": [
        {"@id": "urn:node:請求締め", "@type": "urn:kbil:請求締め", "urn:kbil:締日": "20260824"}
      ]
    }
  ],

  "urn:kbil:請求締め": [
    {
      "_comment": "請求締め(締日:D) :- 締め処理(締日:D, 担当者:管理会社) --Then--> 帳票集約(共通, 個別, 統合). **集約は組込述語1個で、ホーン節は増えない。**",
      "@id": "urn:node:請求締め.head",
      "@type": "urn:kbil:請求締め",
      "urn:kbil:締日": {"@id": "#D"},
      "variables": [{"@id": "#D", "variableName": "D"}],
      "internalGraph": [
        {"@id": "urn:node:締め処理", "@type": "urn:kbil:締め処理",
         "urn:kbil:締日": {"@id": "#D"},
         "urn:kbil:agent": "urn:entity:管理会社"},
        {"_comment": "引数はパターンのノードURI。パターン自体は _aggregationPatterns にある。",
         "@id": "urn:node:集約", "@type": "urn:kbil:帳票集約",
         "共通": "p:common", "個別": "p:individual", "統合": "p:integrated"},
        {"@id": "urn:node:請求締め.head#link1", "@type": "urn:kbil:Then",
         "arg1": {"@id": "urn:node:締め処理"}, "arg2": {"@id": "urn:node:集約"}}
      ]
    }
  ],

  "urn:kbil:締め処理": [{"@id": "urn:node:締め処理.head", "@type": "urn:kbil:締め処理"}],

  "売上伝票明細": [
    {"@id": "d:1", "請求": "未", "締日": "20260824", "請求先": "田中商事", "差出人": "順天堂",
     "商品ID": "A-100", "商品名": "ガーゼ", "数量": 20},
    {"@id": "d:2", "請求": "未", "締日": "20260824", "請求先": "田中商事", "差出人": "順天堂",
     "商品ID": "B-250", "商品名": "注射針", "数量": 5},
    {"@id": "d:3", "請求": "未", "締日": "20260824", "請求先": "田中商事", "差出人": "順天堂",
     "商品ID": "C-300", "商品名": "消毒液", "数量": 3},
    {"@id": "d:4", "請求": "未", "締日": "20260824", "請求先": "佐藤薬局", "差出人": "順天堂",
     "商品ID": "A-100", "商品名": "ガーゼ", "数量": 15}
  ],

  "_aggregationPatterns": [
    {"_comment": "共通: まとめの単位。請求:未 は非変数なので絞り込みの条件になる。",
     "uri": "p:common", "type": "売上伝票明細", "variable": "Line",
     "attributes": {"請求": "未", "締日": {"var": "Date"}, "請求先": {"var": "BillTo"},
                    "差出人": {"var": "Sender"}}},
    {"_comment": "個別: 同じ売上伝票明細（ノードの変数 Line を共有）の別の部分。まとめても1件ずつ残る。",
     "uri": "p:individual", "type": "売上伝票明細", "variable": "Line",
     "attributes": {"商品ID": {"var": "ItemID"}, "商品名": {"var": "ItemName"}, "数量": {"var": "Number"}}},
    {"uri": "p:detail", "type": "請求明細",
     "attributes": {"商品ID": {"var": "ItemID"}, "商品名": {"var": "ItemName"}, "数量": {"var": "Number"}}},
    {"uri": "p:header", "type": "請求書",
     "attributes": {"締日": {"var": "Date"}, "請求先": {"var": "BillTo"}, "差出人": {"var": "Sender"},
                    "明細": {"ref": "p:detail"}}},
    {"uri": "p:integrated", "type": "統合",
     "attributes": {"ヘッダ": {"ref": "p:header"}, "明細": {"ref": "p:detail"}}}
  ]
}
