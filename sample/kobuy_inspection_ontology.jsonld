    "en": "Arg 2"
   }
  },
  {
   "@id": "被除数",
   "@type": "DatatypeProperty",
   "range": "decimal",
   "label": {
    "ja": "被除数",
    "en": "Dividend"
   }
  },
  {
   "@id": "除数",
   "@type": "DatatypeProperty",
   "range": "decimal",
   "label": {
    "ja": "除数",
    "en": "Divisor"
   }
  },
  {
   "@id": "商",
   "@type": "DatatypeProperty",
   "range": "decimal",
   "label": {
    "ja": "商",
    "en": "Quotient"
   }
  },
  {
   "@id": "方式",
   "@type": "DatatypeProperty",
   "range": "string",
   "label": {
    "ja": "方式",
    "en": "Mode"
   }
  },
  {
   "@id": "値",
   "@type": "DatatypeProperty",
   "range": "decimal",
   "label": {
    "ja": "値",
    "en": "Value"
   }
  },
  {
   "@id": "結果",
   "@type": "DatatypeProperty",
   "range": "decimal",
   "label": {
    "ja": "結果",
    "en": "Result"
   }
  },
  {
   "@id": "urn:kinsp:単価",
   "@type": "DatatypeProperty",
   "range": "nonNegativeInteger",
   "label": {
    "ja": "単価",
    "en": "Unit price"
   }
  },
  {
   "@id": "urn:kinsp:出荷数",
   "@type": "DatatypeProperty",
   "range": "nonNegativeInteger",
   "label": {
    "ja": "出荷数",
    "en": "Shipped"
   }
  },
  {
   "@id": "urn:kinsp:検収数",
   "@type": "DatatypeProperty",
   "range": "nonNegativeInteger",
   "label": {
    "ja": "検収数",
    "en": "Accepted"
   }
  },
  {
   "@id": "urn:kinsp:税込金額",
   "@type": "DatatypeProperty",
   "range": "nonNegativeInteger",
   "label": {
    "ja": "税込金額",
    "en": "Gross"
   }
  },
  {
   "@id": "urn:kinsp:消費税額",
   "@type": "DatatypeProperty",
   "range": "nonNegativeInteger",
   "label": {
    "ja": "消費税額",
    "en": "Tax"
   }
  },
  {
   "@id": "urn:kinsp:税抜金額",
   "@type": "DatatypeProperty",
   "range": "nonNegativeInteger",
   "label": {
    "ja": "税抜金額",
    "en": "Net"
   }
  },
  {
   "@id": "urn:kinsp:数量",
   "@type": "DatatypeProperty",
   "range": "nonNegativeInteger",
   "label": {
    "ja": "数量",
    "en": "Quantity"
   }
  },
  {
   "_comment": "消費税率（%）。8 や 10。",
   "@id": "urn:kinsp:税率",
   "@type": "DatatypeProperty",
   "range": "positiveInteger",
   "label": {
    "ja": "消費税率(%)",
    "en": "Tax rate (%)"
   }
  },
  {
   "_comment": "商品単価が税抜か税込か。「税抜」か「税込」。",
   "@id": "urn:kinsp:単価区分",
   "@type": "DatatypeProperty",
   "range": "string",
   "label": {
    "ja": "単価区分",
    "en": "Price basis"
   }
  },
  {
   "_comment": "消費税の端数処理の方式。組込述語 端数処理 の方式名（「切捨て」か「四捨五入」）。サプライヤごとに決まっている。",
   "@id": "urn:kinsp:端数処理",
   "@type": "DatatypeProperty",
   "range": "string",
   "label": {
    "ja": "端数処理",
    "en": "Rounding"
   }
  },
  {
   "_comment": "消費税の計算パターン。①は 端数処理(単価 × 数量 × 税率)、②は 端数処理(単価 × 税率) × 数量。サプライヤごとに決まっている。",
   "@id": "urn:kinsp:計算パターン",
   "@type": "DatatypeProperty",
   "range": "string",
   "label": {
    "ja": "計算パターン",
    "en": "Tax pattern"
   }
  },
  {
   "@id": "urn:kinsp:名前",
   "@type": "DatatypeProperty",
   "range": "string",
   "label": {
    "ja": "名前",
    "en": "Name"
   }
  },
  {
   "@id": "urn:kinsp:サプライヤ",
   "@type": "ObjectProperty",
   "range": "urn:kinsp:サプライヤ",
   "label": {
    "ja": "サプライヤ",
    "en": "Supplier"
   }
  },
  {
   "@id": "urn:kinsp:計算例一覧",
   "@type": "ObjectProperty",
   "range": "urn:kinsp:消費税計算",
   "label": {
    "ja": "計算例",
    "en": "Examples"
   }
  },
  {
   "@id": "urn:kinsp:税抜相当",
   "@type": "DatatypeProperty",
   "range": "decimal",
   "label": {
    "ja": "税抜相当",
    "en": "Net (raw)"
   }
  },
  {
   "@id": "urn:kinsp:税額素",
   "@type": "DatatypeProperty",
   "range": "decimal",
   "label": {
    "ja": "端数処理前の税額",
    "en": "Tax (raw)"
   }
  },
  {
   "_comment": "検収は取消可能タスクである（マニュアル §3.2.7.1「検収取消」）。担当はバイヤー。",
   "@id": "urn:kinsp:検収",
   "@type": "Class",
   "subClassOf": [
    "urn:kinsp:Cancelable",
    {
     "@type": "Restriction",
     "onProperty": "urn:kinsp:検収数",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:kinsp:agent",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "wam:completeOrSuspendByOkButton",
     "minCardinality": 0,
     "maxCardinality": 1
    }
   ],
   "label": {
    "ja": "検収",
    "en": "Accept"
   }
  },
  {
   "_comment": "売上伝票は検収の結果として自動的に計上される（マニュアル §6.5.1）。担当者を持たないので人の操作を待たない——Then の後続として、検収が成立した時点で立つ。**補償可能である**——計上は取り消せないので、打ち消すには赤伝票を立てる（マニュアル §6.5.5・§6.5.6：訂正も取消も赤伝票で行う）。検収を引き戻すと、バックトラック伝播がこの伝票をまたぐところで赤伝票が起きる。",
   "@id": "urn:kinsp:売上伝票",
   "@type": "Class",
   "subClassOf": [
    "urn:kinsp:Compensable",
    {
     "@type": "Restriction",
     "onProperty": "urn:kinsp:検収数",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:kinsp:税込金額",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:kinsp:消費税額",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:kinsp:税抜金額",
     "minCardinality": 1,
     "maxCardinality": 1
    }
   ],
   "label": {
    "ja": "売上伝票",
    "en": "Sales slip"
   },
   "urn:kinsp:compensatesWith": "urn:kinsp:赤伝票"
  },
  {
   "_comment": "サプライヤ。消費税の端数処理の方式と計算パターンを持つ（Wiki「各外部連携の端数処理について」の表）。",
   "@id": "urn:kinsp:サプライヤ",
   "@type": "Class",
   "subClassOf": [
    {
     "@type": "Restriction",
     "onProperty": "urn:kinsp:名前",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:kinsp:端数処理",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:kinsp:計算パターン",
     "minCardinality": 1,
     "maxCardinality": 1
    }
   ],
   "label": {
    "ja": "サプライヤ",
    "en": "Supplier"
   }
  },
  {
   "_comment": "明細1行の消費税を計算する（Wiki「Kobuyでの消費税計算方法」）。単価区分と計算パターンで代替節が選ばれる。税抜・税込・消費税のどれも整数（円）。",
   "@id": "urn:kinsp:消費税計算",
   "@type": "Class",
   "subClassOf": [
    "urn:kinsp:OtherAtom",
    {
     "@type": "Restriction",
     "onProperty": "urn:kinsp:単価",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:kinsp:数量",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:kinsp:税率",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:kinsp:端数処理",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:kinsp:計算パターン",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:kinsp:単価区分",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:kinsp:税抜金額",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:kinsp:消費税額",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:kinsp:税込金額",
     "minCardinality": 0,
     "maxCardinality": 1
    }
   ],
   "label": {
    "ja": "消費税計算",
    "en": "Tax calculation"
   }
  },
  {
   "_comment": "Wiki の計算例を並べるためのゴール。計算例一覧の各行が 消費税計算 のノードで、その節が解かれて税抜・消費税・税込が入る。",
   "@id": "urn:kinsp:消費税の計算例",
   "@type": "Class",
   "subClassOf": [
    "urn:kinsp:Task",
    {
     "@type": "Restriction",
     "onProperty": "urn:kinsp:計算例一覧",
     "minCardinality": 1
    }
   ],
   "label": {
    "ja": "消費税の計算例",
    "en": "Tax examples"
   }
  },
