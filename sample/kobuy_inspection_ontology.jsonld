  {
   "_comment": "赤伝票は売上伝票の補償タスクである。元の伝票の引数がそのままコピーされて渡る。",
   "@id": "urn:kinsp:赤伝票",
   "@type": "Class",
   "subClassOf": [
    "urn:kinsp:Task",
    {
     "@type": "Restriction",
