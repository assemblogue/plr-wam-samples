  "urn:ship:出荷": [
    {
      "@id": "urn:node:出荷.head",
      "@type": "urn:ship:出荷",
      "urn:ship:個数": {
        "@id": "#S"
      },
      "variables": [
        {
          "@id": "#S",
          "variableName": "S"
        }
      ],
      "_comment": "出荷(個数:S). 出荷数の上限 ≧(要出荷数, [出荷済数, 個数]) は 出荷+検収 の本体にある制約ノードで、連立で解かれるのでどちらに書いても同じ"
    }
  ]
}
