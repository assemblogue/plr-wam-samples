     "maxCardinality": 1
    }
   ],
   "label": "チャネル"
  },
  {
   "@id": "#inChannel",
   "@type": "ObjectProperty",
   "label": "チャネル"
  },
  {
   "@id": "#ontoC",
   "@type": "ObjectProperty",
   "label": "チャネル設定"
  },
  {
   "@id": "#onto0",
   "@type": "DatatypeProperty",
   "label": "名前",
   "range": "string"
  },
  {
   "@id": "urn:bud:Group",
   "@type": "Class",
   "subClassOf": [
    {
     "@type": "Restriction",
     "onProperty": "#メンバー",
     "minCardinality": 0
    }
   ],
   "label": "グループ"
  },
  {
   "@id": "#メンバー",
   "@type": "ObjectProperty",
   "label": "メンバー",
   "subPropertyOf": [
    "#hasNestedElement"
   ]
  },
  {
   "@id": "#_initiator",
   "@type": "ObjectProperty",
   "label": "起案者（分割チャネル）"
  },
  {
   "@id": "urn:bud:Post",
   "@type": "Class",
   "subClassOf": [
    {
     "@type": "Restriction",
     "onProperty": "#就任者",
     "minCardinality": 0
    }
   ],
   "label": "役職",
   "_comment": "予算管理担当（追記R802）。成員の主体になる"
  },
  {
   "@id": "#就任者",
   "@type": "ObjectProperty",
   "label": "就任者",
   "subPropertyOf": [
    "#hasElement"
   ]
  },
  {
   "@id": "#retrieveAll",
   "@type": "ObjectProperty",
   "subPropertyOf": [
    "#retrieve",
    "#refersTo"
   ],
   "label": "検索してすべて集める",
   "_comment": "仮の宣言（R736・R910。系のオントロジーに入るまで）。当たるものをすべて集める検索の欄。新しい核だけが読む"
  },
  {
   "@id": "urn:bud:confirmedList",
   "@type": "ObjectProperty",
   "range": "urn:bud:Approval",
   "subPropertyOf": "#retrieveAll",
   "label": "確定一覧",
   "_comment": "その予算の、OK で完成した承認（R736）"
  }
 ],
 "channelProperty": "inChannel",
 "taskAccess": {
  "_comment": "グループのメンバー・役職の就任者をたどる属性（成員）",
  "memberProperties": [
   "メンバー",
   "就任者"
  ]
 }
}
