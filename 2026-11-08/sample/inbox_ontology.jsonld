   "@type": "Class",
   "subClassOf": [
    "#OtherAtom",
    "urn:inbox:Atom"
   ],
   "label": {
    "ja": "その他のアトムノード",
    "en": "Other atom"
   }
  },
  {
   "@id": "urn:inbox:Cancelable",
   "@type": "Class",
   "subClassOf": [
    "urn:inbox:Task",
    "#Cancelable"
   ],
   "label": {
    "ja": "取消可能タスク",
    "en": "Cancelable"
   }
  },
  {
   "@id": "#Person",
   "_comment": "Profile.xlsx で定義されたクラス Person（追記R531・R532）",
   "@type": "Class",
   "subClassOf": [],
   "label": {
    "ja": "人",
    "en": "Person"
   }
  },
  {
   "@id": "#agent",
   "@type": "ObjectProperty",
   "label": {
    "ja": "担当者",
    "en": "Agent"
   }
  },
  {
   "@id": "urn:inbox:Geq",
   "@type": "Class",
   "subClassOf": [
    "urn:inbox:Constraint"
   ],
   "label": {
    "ja": "≧",
    "en": "AtLeast"
   },
   "#builtInFunction": "greaterEqual",
   "isConstraint": true
  },
  {
   "@id": "urn:inbox:Then",
   "@type": "Class",
   "label": {
    "ja": "Then",
    "en": "Then"
   },
   "subClassOf": [
    "#Then"
   ]
  },
  {
   "@id": "arg1",
