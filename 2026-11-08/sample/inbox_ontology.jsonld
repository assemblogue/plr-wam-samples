   ],
   "label": {
    "ja": "＝",
    "en": "Equals"
   },
   "#builtInFunction": "equal",
   "isConstraint": true
  },
  {
   "@id": "urn:inbox:budget",
   "@type": "DatatypeProperty",
   "range": "string",
   "label": {
    "ja": "予算",
    "en": "Budget"
   },
   "_comment": "予算の識別子（予算コード）"
  },
  {
