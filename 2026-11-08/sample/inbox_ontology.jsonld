    "urn:inbox:Cancelable",
    {
     "@type": "Restriction",
     "onProperty": "urn:inbox:approvedMatter",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:inbox:approvedAmount",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#agent",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#completeOrSuspendByOkButton",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:inbox:approvedBudget",
     "minCardinality": 1,
     "maxCardinality": 1
    }
   ],
   "label": {
    "ja": "承認",
    "en": "Approve"
   }
  },
  {
   "@id": "urn:inbox:InspectionWork",
   "@type": "Class",
   "subClassOf": [
    "urn:inbox:Cancelable",
    {
     "@type": "Restriction",
     "onProperty": "urn:inbox:matter",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:inbox:quantity",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#agent",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#completeOrSuspendByOkButton",
     "minCardinality": 0,
     "maxCardinality": 1
    }
   ],
   "label": {
    "ja": "検収",
