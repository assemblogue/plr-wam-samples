   }
  },
  {
   "@id": "urn:inbox:Procurement",
   "@type": "Class",
   "subClassOf": [
    "urn:inbox:Task",
    {
     "@type": "Restriction",
     "onProperty": "urn:inbox:matter",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:inbox:approver",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:inbox:amount",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#agent",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#inChannel",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#agent",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:inbox:budget",
     "minCardinality": 1,
     "maxCardinality": 1
    }
   ],
   "label": {
    "ja": "調達",
    "en": "Procurement"
   },
   "_comment": "業務フローノードの型（ゴール述語）。案件ごとのレコードが業務フローとして起動する（追記R494）"
  },
  {
   "@id": "urn:inbox:Inspection",
   "@type": "Class",
   "subClassOf": [
    "urn:inbox:Task",
    {
     "@type": "Restriction",
     "onProperty": "urn:inbox:matter",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#agent",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#inChannel",
     "minCardinality": 0,
     "maxCardinality": 1
    }
   ],
   "label": {
    "ja": "検収",
    "en": "Acceptance"
   },
   "_comment": "業務フローノードの型（ゴール述語）。案件ごとのレコードが業務フローとして起動する（追記R494）"
  },
  {
   "@id": "urn:inbox:refersTo",
   "@type": "ObjectProperty",
   "label": {
    "ja": "参照",
    "en": "Refers to"
   }
  },
  {
   "@id": "urn:inbox:procurements",
   "@type": "ObjectProperty",
   "range": "urn:inbox:Procurement",
   "subPropertyOf": "urn:inbox:refersTo",
   "_comment": "誰も書かない refersTo の多値。予算合計の節が検索で値を作る（追記R554・R558・R560）。データには書かない",
   "label": {
    "ja": "調達",
    "en": "Procurements"
   }
  },
  {
   "@id": "urn:inbox:Budget",
   "@type": "Class",
   "_comment": "マスターのレコード（R488）。利用者が1人の予算で、担当者（agent）は予算管理担当の人である——予算合計を作り、承認する（追記R568・R802）。調達の節が existing: _true で検索する",
   "subClassOf": [
    "urn:inbox:Task",
    {
     "@type": "Restriction",
     "onProperty": "urn:inbox:budgetCode",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:inbox:users",
     "minCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:inbox:limit",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:inbox:procurements",
     "minCardinality": 0
    },
    {
     "@type": "Restriction",
     "onProperty": "#agent",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#completeByOkButton",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#inChannel",
     "minCardinality": 0,
     "maxCardinality": 1
    }
   ],
   "label": {
    "ja": "予算",
    "en": "Budget"
   }
  },
  {
   "@id": "urn:inbox:Equals",
   "@type": "Class",
   "subClassOf": [
