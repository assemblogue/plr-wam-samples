    "en": "Confirmed total"
   }
  },
  {
   "@id": "urn:inbox:confirmedMatters",
   "@type": "DatatypeProperty",
   "range": "string",
   "label": {
    "ja": "確定案件",
    "en": "Confirmed cases"
   }
  },
  {
   "@id": "urn:inbox:BudgetTotal",
   "@type": "Class",
   "subClassOf": [
    "urn:inbox:Cancelable",
    {
     "@type": "Restriction",
     "onProperty": "urn:inbox:budget",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:inbox:limit",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
