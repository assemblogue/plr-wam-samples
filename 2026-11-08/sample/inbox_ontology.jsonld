   "@type": "DatatypeProperty",
   "range": "nonNegativeInteger",
   "label": {
    "ja": "金額",
    "en": "Amount"
   }
  },
  {
   "@id": "urn:inbox:limit",
   "@type": "DatatypeProperty",
   "range": "nonNegativeInteger",
   "label": {
    "ja": "限度額",
    "en": "Limit"
   }
  },
  {
