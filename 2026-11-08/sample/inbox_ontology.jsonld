     "minCardinality": 0
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:inbox:confirmedTotal",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "urn:inbox:confirmedMatters",
     "minCardinality": 0
    },
    {
     "@type": "Restriction",
     "onProperty": "#agent",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#inChannel",
     "minCardinality": 0,
     "maxCardinality": 1
    }
   ],
   "label": {
    "ja": "予算合計",
    "en": "Budget total"
   },
   "_comment": "予算管理担当（承認者）が作る、予算の合計のレコード（ゴール述語。トーク的業務）。合計と案件の ID だけを持つ（追記R547・R563・R567・R568） 取消可能タスク——巻き戻しでレコードも取り消す（追記R573）"
  },
  {
   "@id": "#ONTOc1",
   "@type": "Class",
   "_comment": "チャネル（追記R494・R488。調達・検収の業務フローノードがチャネルに並ぶ）",
   "subClassOf": [
    {
     "@type": "Restriction",
     "onProperty": "#ontoC",
     "minCardinality": 1,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#onto0",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#_initiator",
     "minCardinality": 0,
     "maxCardinality": 1
    },
    {
     "@type": "Restriction",
     "onProperty": "#agent",
     "minCardinality": 0,
     "maxCardinality": 1
    }
   ],
   "label": "チャネル"
  },
  {
   "@id": "#inChannel",
   "@type": "ObjectProperty",
   "label": "チャネル"
  },
  {
   "@id": "#ontoC",
   "@type": "ObjectProperty",
   "label": "チャネル設定"
  },
  {
   "@id": "#onto0",
   "@type": "DatatypeProperty",
   "label": "名前",
   "range": "string"
  },
  {
   "@id": "urn:inbox:Group",
   "@type": "Class",
   "subClassOf": [
    {
     "@type": "Restriction",
     "onProperty": "#メンバー",
     "minCardinality": 0
    }
   ],
   "label": "グループ"
  },
  {
   "@id": "#メンバー",
   "@type": "ObjectProperty",
   "label": "メンバー",
   "subPropertyOf": [
    "#hasNestedElement"
   ]
  },
  {
   "@id": "#_initiator",
   "@type": "ObjectProperty",
   "label": "起案者（分割チャネル）"
  },
  {
   "@id": "urn:inbox:approvedMatter",
   "@type": "DatatypeProperty",
   "domain": "urn:inbox:Approval",
   "range": "string",
   "label": {
    "ja": "案件",
    "en": "Case"
   },
   "subPropertyOf": "urn:inbox:refersTo",
   "_comment": "承認から見た案件は、ほかの担当者が入れた値を読む値である——refersTo の下位属性として宣言する（受け渡しは、渡す側の欄を受け取る側が refersTo の属性で読む。追記R517）。refersTo の下位属性は編集権限を広げないので、承認の担当者はこれを書けない（追記R626）"
  },
  {
   "@id": "urn:inbox:approvedAmount",
   "@type": "DatatypeProperty",
   "domain": "urn:inbox:Approval",
   "range": "nonNegativeInteger",
   "label": {
    "ja": "金額",
    "en": "Amount"
   },
   "subPropertyOf": "urn:inbox:refersTo",
   "_comment": "承認から見た金額は、ほかの担当者が入れた値を読む値である——refersTo の下位属性として宣言する（受け渡しは、渡す側の欄を受け取る側が refersTo の属性で読む。追記R517）。refersTo の下位属性は編集権限を広げないので、承認の担当者はこれを書けない（追記R626）"
  },
  {
   "@id": "urn:inbox:approvedBudget",
   "@type": "DatatypeProperty",
   "domain": "urn:inbox:Approval",
   "range": "string",
   "label": {
    "ja": "予算",
    "en": "Budget"
   },
   "subPropertyOf": "urn:inbox:refersTo",
   "_comment": "承認から見た予算は、ほかの担当者が入れた値を読む値である——refersTo の下位属性として宣言する（受け渡しは、渡す側の欄を受け取る側が refersTo の属性で読む。追記R517）。refersTo の下位属性は編集権限を広げないので、承認の担当者はこれを書けない（追記R626）"
  },
  {
   "@id": "urn:inbox:Post",
   "@type": "Class",
   "subClassOf": [
    {
     "@type": "Restriction",
     "onProperty": "#就任者",
     "minCardinality": 0
    }
   ],
   "label": "役職",
   "_comment": "予算管理担当（追記R802）。成員の主体になる"
  },
  {
   "@id": "#就任者",
   "@type": "ObjectProperty",
   "label": "就任者",
   "subPropertyOf": [
    "#hasElement"
   ]
  },
  {
   "@id": "#retrieveAll",
   "@type": "ObjectProperty",
   "subPropertyOf": [
    "#retrieve",
    "#refersTo"
   ],
   "label": "検索してすべて集める",
   "_comment": "仮の宣言（R736・R910。系のオントロジーに入るまで）。当たるものをすべて集める検索の欄。新しい核だけが読む"
  },
  {
   "@id": "urn:inbox:confirmedList",
   "@type": "ObjectProperty",
   "range": "urn:inbox:Approval",
   "subPropertyOf": "#retrieveAll",
   "label": "確定一覧",
   "_comment": "その予算の、OK で完成した承認（R736）"
  }
 ],
 "channelProperty": "inChannel",
 "taskAccess": {
  "_comment": "役職の就任者・グループのメンバーをたどる属性（成員・担当者の判定。追記R546）",
  "memberProperties": [
   "メンバー",
   "就任者"
  ]
 }
}
