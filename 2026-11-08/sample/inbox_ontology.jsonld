    "ja": "利用者",
    "en": "User"
   },
   "_comment": "その予算で起案できる人（多値。inbox の予算はどれも1人）"
  },
  {
   "@id": "urn:inbox:approver",
   "@type": "ObjectProperty",
   "range": "#Person",
   "label": {
    "ja": "承認者",
    "en": "Approver"
   }
  },
  {
   "@id": "urn:inbox:Draft",
   "@type": "Class",
