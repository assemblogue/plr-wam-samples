  },
  {
   "@id": "urn:tw:approvedSubject",
   "@type": "DatatypeProperty",
   "domain": "urn:tw:Approval",
   "range": "string",
   "label": "件名",
   "subPropertyOf": "#refersTo",
   "_comment": "承認から見た件名——起案者が入れた値を承認者が読む（R517）。承認者は書けない（R626）"
  },
  {
   "@id": "urn:tw:approvedAmount",
   "@type": "DatatypeProperty",
   "domain": "urn:tw:Approval",
   "range": "nonNegativeInteger",
   "label": "金額",
   "subPropertyOf": "#refersTo",
   "_comment": "承認から見た金額——起案者が入れた値を承認者が読む（R517）。承認者は書けない（R626）"
  },
  {
   "@id": "urn:tw:approvedBudget",
   "@type": "DatatypeProperty",
   "domain": "urn:tw:Approval",
   "range": "string",
   "label": "予算",
   "subPropertyOf": "#refersTo",
   "_comment": "承認から見た予算——起案者が入れた値を承認者が読む（R517）。承認者は書けない（R626）"
  },
  {
   "@id": "#retrieveAll",
   "@type": "ObjectProperty",
   "subPropertyOf": [
    "#retrieve",
    "#refersTo"
   ],
   "label": "検索してすべて集める",
   "_comment": "仮の宣言（R736・R910。系のオントロジーに入るまで）。当たるものをすべて集める検索の欄。新しい核だけが読む"
  },
  {
   "@id": "urn:tw:confirmedList",
   "@type": "ObjectProperty",
   "range": "urn:tw:Approval",
   "subPropertyOf": "#retrieveAll",
   "label": "確定一覧",
   "_comment": "その予算の、判断が承認の完成した承認（R736）"
  },
  {
   "@id": "#suspendedBy",
   "@type": "ObjectProperty",
   "range": "#Person",
   "label": "中断した人",
   "_comment": "仮の宣言（R912。系のオントロジーを直すのは切り替えのとき）。中断ありの OK で中断した人。最大1。新しい核だけが読み、completeOrSuspendByOkButton は読まない"
  }
 ]
}
