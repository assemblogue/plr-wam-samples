   "range": "string",
   "label": "商品名"
  },
  {
   "@id": "urn:tw:unitPrice",
   "@type": "DatatypeProperty",
   "range": "nonNegativeInteger",
   "label": "単価"
  },
  {
   "@id": "urn:tw:supplier",
   "@type": "ObjectProperty",
   "range": "#Group",
   "label": "サプライヤー",
   "_comment": "その商品を納品し請求する会社（グループ）。納品・請求の担当者の欄に渡し、メンバーが引き受ける"
  },
  {
   "@id": "urn:tw:targetLine",
