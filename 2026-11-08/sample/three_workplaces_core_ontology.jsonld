   "@type": "DatatypeProperty",
   "range": "date",
   "label": "発注日"
  },
  {
   "@id": "urn:tw:deliveredQuantity",
   "@type": "DatatypeProperty",
   "range": "nonNegativeInteger",
   "label": "納品数"
  },
  {
   "@id": "urn:tw:inspectedQuantity",
   "@type": "DatatypeProperty",
   "range": "nonNegativeInteger",
   "label": "検収数"
  },
  {
   "@id": "urn:tw:invoiceNumber",
   "@type": "DatatypeProperty",
   "range": "string",
   "label": "請求書番号"
  },
  {
   "@id": "urn:tw:billedAmount",
   "@type": "DatatypeProperty",
   "range": "nonNegativeInteger",
   "label": "請求額"
  },
  {
   "@id": "urn:tw:paymentDate",
   "@type": "DatatypeProperty",
   "range": "date",
   "label": "支払日"
  },
  {
   "@id": "urn:tw:lines",
   "@type": "ObjectProperty",
   "range": "urn:tw:Line",
   "label": "明細"
  },
  {
   "@id": "urn:tw:product",
   "@type": "ObjectProperty",
   "range": "urn:tw:Product",
   "label": "商品",
   "subPropertyOf": "#refersTo",
   "_comment": "明細が指す商品。refersTo の下位なので、商品マスターの編集権限と OK の凍結を明細に持ち込まない"
  },
  {
   "@id": "urn:tw:quantity",
   "@type": "DatatypeProperty",
   "range": "nonNegativeInteger",
   "label": "数量"
  },
