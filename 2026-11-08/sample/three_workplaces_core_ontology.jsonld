  },
  {
   "@id": "urn:tw:confirmedTotal",
   "@type": "DatatypeProperty",
   "range": "nonNegativeInteger",
   "label": "確定合計"
  },
  {
   "@id": "urn:tw:confirmedMatters",
   "@type": "DatatypeProperty",
   "range": "string",
   "label": "確定案件",
